# AIRPORTCHA 环境变量示例（复制为 .env 使用，严禁将真实 .env 提交到 GitHub）

# 正式生产域名（静态导出 Canonical 与 Sitemap 使用）
SITE_URL=https://airportcha.com

# 本地 WordPress 开发地址
WP_LOCAL_URL=http://127.0.0.1:9400

# IndexNow 密钥（可选，正式上线后在 Bing Webmaster Tools 配置）
INDEXNOW_KEY=

# Cloudflare D1 / 统计管理接口保护密钥（可选，严禁公开）
STATS_ADMIN_TOKEN=
